generator client {
  provider = "prisma-client-js"
}
datasource db {
  provider = "postgresql"
}
model Project {
  id String @id @default(uuid()) @db.Uuid
  owner String @db.Uuid
  name String
  kind String
  context Json
  revision Int @default(0)
  published Boolean @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  files File[]
  versions Version[]
  messages Message[]
  testRuns TestRun[]
  publications Publication[]
  @@index([owner,updatedAt])
}
model File {
  id String @id @default(uuid()) @db.Uuid
  projectId String @db.Uuid
  project Project @relation(fields:[projectId],references:[id],onDelete:Cascade)
  path String
  ext String
  content String
  @@unique([projectId,path])
}
model Version {
  id String @id @default(uuid()) @db.Uuid
  projectId String @db.Uuid
  project Project @relation(fields:[projectId],references:[id],onDelete:Cascade)
  number Int
  context Json
  sizeBytes Int @default(0)
  createdAt DateTime @default(now())
  @@unique([projectId,number])
}
model Message {
  id String @id @default(uuid()) @db.Uuid
  projectId String @db.Uuid
  project Project @relation(fields:[projectId],references:[id],onDelete:Cascade)
  role String
  content String
  createdAt DateTime @default(now())
  @@index([projectId,createdAt])
}
model TestRun {
  id String @id @default(uuid()) @db.Uuid
  projectId String @db.Uuid
  project Project @relation(fields:[projectId],references:[id],onDelete:Cascade)
  input String
  output String
  status String
  costMicros Int @default(0)
  createdAt DateTime @default(now())
}
model Publication {
  id String @id @default(uuid()) @db.Uuid
  projectId String @db.Uuid
  project Project @relation(fields:[projectId],references:[id],onDelete:Cascade)
  name String
  kind String
  description String
  version String
  snapshot Json
  sizeBytes Int @default(0)
  createdAt DateTime @default(now())
  @@index([createdAt])
}
model ExecLog {
  id String @id @default(uuid()) @db.Uuid
  owner String @db.Uuid
  sessionId String
  command String
  ok Boolean
  durationMs Int
  createdAt DateTime @default(now())
  @@index([createdAt])
}
