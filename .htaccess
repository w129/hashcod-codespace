<IfModule mod_rewrite.c>
    RewriteEngine On

    # Si es archivo o directorio existente físico, servirlo directamente
    RewriteCond %{REQUEST_FILENAME} -f [OR]
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteRule ^ - [L]

    # Enrutar todo lo demás a router.php
    RewriteRule ^(.*)$ router.php [QSA,L]
</IfModule>
