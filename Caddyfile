{
	admin off
	auto_https off
	servers {
		timeouts {
			read_body 30s
			read_header 10s
			write 120s
			idle 60s
		}
	}
}

# Railway termina TLS en el edge. Caddy solo escucha HTTP interno en $PORT.
http://:{$PORT:8000} {
	# Health check: Caddy responde cuando PHP está vivo.
	handle /healthz {
		rewrite * /robots.txt
		reverse_proxy 127.0.0.1:8001 {
			transport http {
				dial_timeout 1s
				response_header_timeout 3s
			}
		}
	}

	# Bloqueo de herramientas internas peligrosas en producción pública.
	@dangerousInternal {
		path /api/bash /api/bash/* /api/catalyst /api/catalyst/* /api/storage /api/storage/* /api/django /api/django/*
	}
	handle @dangerousInternal {
		header Cache-Control "no-store"
		header X-Content-Type-Options "nosniff"
		respond "Not Found" 404
	}

	# Streamlit queda cerrado públicamente. Si se necesita después, debe ir detrás de admin/auth.
	@streamlit path /st /st/*
	handle @streamlit {
		header Cache-Control "no-store"
		header X-Content-Type-Options "nosniff"
		respond "Not Found" 404
	}

	# Canonical HTTP para portada.
	@home path / /index.php /index.html
	header @home Link "<https://hashcodcodespace.dev/>; rel=canonical"

	# Páginas públicas limpias para SEO y navegación.
	handle /services /services/ {
		root * /var/www/html/services
		rewrite * /index.html
		header Content-Type "text/html; charset=utf-8"
		header Cache-Control "public, max-age=300, stale-while-revalidate=86400"
		file_server
	}
	handle /pricing /pricing/ {
		root * /var/www/html/pricing
		rewrite * /index.html
		header Content-Type "text/html; charset=utf-8"
		header Cache-Control "public, max-age=300, stale-while-revalidate=86400"
		file_server
	}
	handle /clients /clients/ {
		root * /var/www/html/clients
		rewrite * /index.html
		header Content-Type "text/html; charset=utf-8"
		header Cache-Control "public, max-age=300, stale-while-revalidate=86400"
		file_server
	}
	handle /status /status/ {
		root * /var/www/html/status
		rewrite * /index.html
		header Content-Type "text/html; charset=utf-8"
		header Cache-Control "public, max-age=300, stale-while-revalidate=86400"
		file_server
	}

	# SEO público directo.
	handle /robots.txt {
		root * /var/www/html
		header Content-Type "text/plain; charset=utf-8"
		header Cache-Control "no-store, max-age=0, must-revalidate"
		header -ETag
		header -Last-Modified
		file_server
	}
	handle /sitemap.xml {
		root * /var/www/html
		header Content-Type "application/xml; charset=utf-8"
		header Cache-Control "no-store, max-age=0, must-revalidate"
		header -ETag
		header -Last-Modified
		file_server
	}

	# Loader que debe actualizarse sin quedar congelado.
	handle /components/platform-entry-capability-footer-fix.js {
		root * /var/www/html
		encode zstd gzip
		header Cache-Control "no-store, max-age=0, must-revalidate"
		header -ETag
		file_server
	}

	# Monitor de seguridad saneado.
	handle /components/codespace-security-monitor.js {
		root * /var/www/html
		encode zstd gzip
		header Cache-Control "no-store, max-age=0, must-revalidate"
		header -ETag
		file_server
	}

	# Static assets directos con compresión y allowlist.
	@static {
		path *.css *.js *.mjs *.svg *.png *.jpg *.jpeg *.gif *.webp *.ico *.woff *.woff2 *.wasm *.ttf *.map *.webmanifest
		not path /data_storage/*
		not path /uploads/*
		not path /.git/*
		not path /supabase/*
		not path /vendor/*
		not path /node_modules/*
	}
	handle @static {
		root * /var/www/html
		encode zstd gzip

		@versioned {
			query v=* ver=* hash=* t=* id=*
			path_regexp hashed -[a-zA-Z0-9_-]{6,}\.(js|css|wasm|svg|png|woff2?)$
		}
		header @versioned Cache-Control "public, max-age=31536000, immutable"
		header not @versioned Cache-Control "public, max-age=86400, stale-while-revalidate=604800"

		file_server {
			hide .git data_storage uploads supabase vendor node_modules
		}
	}

	# Plataforma PHP dinámica.
	handle {
		encode zstd gzip

		@untrustedAdminIngress {
			not remote_ip private_ranges 173.245.48.0/20 103.21.244.0/22 103.22.200.0/22 103.31.4.0/22 141.101.64.0/18 108.162.192.0/18 190.93.240.0/20 188.114.96.0/20 197.234.240.0/22 198.41.128.0/17 162.158.0.0/15 104.16.0.0/13 104.24.0.0/14 172.64.0.0/13 131.0.72.0/22 2400:cb00::/32 2606:4700::/32 2803:f800::/32 2405:b500::/32 2405:8100::/32 2a06:98c0::/29 2c0f:f248::/32
		}
		request_header @untrustedAdminIngress -CF-Connecting-IP
		reverse_proxy 127.0.0.1:8001 {
			header_up -X-L8-Railway-Real-Ip
			header_up X-L8-Railway-Real-Ip {http.request.header.X-Real-IP}
			header_up -X-L8-Railway-Request-Id
			header_up X-L8-Railway-Request-Id {http.request.header.X-Railway-Request-Id}
			header_up X-L8-Render-Cf-Ip {http.request.header.CF-Connecting-IP}
			header_up -X-L8-Render-Xff
			transport http {
				dial_timeout 3s
				response_header_timeout 60s
				read_buffer 4096
				write_buffer 4096
			}
		}
	}
}
