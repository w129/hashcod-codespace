{
	admin off
	auto_https off
}

# Render termina TLS en el edge y llega HTTP a $PORT.
# Sin "http://:" Caddy trata el número como hostname y sirve HTTPS →
# "Client sent an HTTP request to an HTTPS server."
http://:{$PORT:8000} {
	encode gzip

	# SEO estático: robots + sitemap (sin PHP / sin headers CORP que confunden a crawlers)
	handle /robots.txt {
		root * /var/www/html
		rewrite * /robots.txt
		file_server
		header {
			Content-Type "text/plain; charset=utf-8"
			Cache-Control "public, max-age=3600, s-maxage=86400"
			X-Content-Type-Options "nosniff"
			-Cross-Origin-Resource-Policy
			-Cross-Origin-Opener-Policy
			-Content-Security-Policy
			-X-Frame-Options
		}
	}
	handle /sitemap.xml {
		root * /var/www/html
		rewrite * /sitemap.xml
		file_server
		header {
			Content-Type "application/xml; charset=utf-8"
			Cache-Control "public, max-age=3600, s-maxage=86400"
			X-Content-Type-Options "nosniff"
			-Cross-Origin-Resource-Policy
			-Cross-Origin-Opener-Policy
			-Content-Security-Policy
			-X-Frame-Options
		}
	}

	# Streamlit slots (websockets vía reverse_proxy)
	@st1 path /st/1 /st/1/*
	handle @st1 {
		reverse_proxy 127.0.0.1:8501
	}
	@st2 path /st/2 /st/2/*
	handle @st2 {
		reverse_proxy 127.0.0.1:8502
	}
	@st3 path /st/3 /st/3/*
	handle @st3 {
		reverse_proxy 127.0.0.1:8503
	}
	@st4 path /st/4 /st/4/*
	handle @st4 {
		reverse_proxy 127.0.0.1:8504
	}
	@st5 path /st/5 /st/5/*
	handle @st5 {
		reverse_proxy 127.0.0.1:8505
	}
	@st6 path /st/6 /st/6/*
	handle @st6 {
		reverse_proxy 127.0.0.1:8506
	}
	@st7 path /st/7 /st/7/*
	handle @st7 {
		reverse_proxy 127.0.0.1:8507
	}
	@st8 path /st/8 /st/8/*
	handle @st8 {
		reverse_proxy 127.0.0.1:8508
	}

	# Plataforma PHP
	handle {
		reverse_proxy 127.0.0.1:8001
	}
}
