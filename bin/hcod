#!/usr/bin/env php
<?php
/**
 * hcod verify <HC-YYYY-NNNNNN> [--base https://host] [--cod file.cod] [--asset file] [--ca ca.pem]
 *
 * Runs the five checks of a constancia from the terminal, exactly like the public verification page:
 *   signature (eddsa-jcs-2022 vs did.json) · JCS fingerprint · reproducible commitment (hash / Merkle root; --asset compares a file)
 *   · RFC 3161 time stamp (chain verified with --ca) · role separation.
 * Exit code 0 only when every check passes. Without --cod the package and did.json are fetched from the issuer domain.
 */
if (PHP_SAPI !== 'cli') { http_response_code(404); exit; }
require_once __DIR__ . '/../constancia-lib.php';

$args = array_slice($argv, 1);
$opts = []; $pos = [];
for ($i = 0; $i < count($args); $i++) {
    if (str_starts_with($args[$i], '--')) { $opts[substr($args[$i], 2)] = $args[++$i] ?? ''; } else { $pos[] = $args[$i]; }
}
if (($pos[0] ?? '') !== 'verify' || !isset($pos[1]) || !preg_match('/^HC-\d{4}-\d{6}$/', $pos[1])) {
    fwrite(STDERR, "Usage: hcod verify HC-YYYY-NNNNNN [--base https://host] [--cod file.cod] [--asset file] [--ca ca.pem]\n"); exit(2);
}
$number = $pos[1];
$base = rtrim($opts['base'] ?? 'https://' . constanciaDomain(), '/');
if (!preg_match('#^https?://[A-Za-z0-9.-]+(:\d+)?$#', $base)) { fwrite(STDERR, "Invalid --base\n"); exit(2); }

function hcodGet(string $url): ?string {
    $ch = curl_init($url);
    curl_setopt_array($ch, [CURLOPT_RETURNTRANSFER => true, CURLOPT_TIMEOUT => 20, CURLOPT_CONNECTTIMEOUT => 8, CURLOPT_FOLLOWLOCATION => false, CURLOPT_PROTOCOLS => CURLPROTO_HTTP | CURLPROTO_HTTPS]);
    $body = curl_exec($ch); $code = (int)curl_getinfo($ch, CURLINFO_RESPONSE_CODE); curl_close($ch);
    return is_string($body) && $code === 200 ? $body : null;
}

$cod = isset($opts['cod']) ? @file_get_contents($opts['cod']) : hcodGet("$base/api/constancia/public/$number.cod");
if (!is_string($cod)) { fwrite(STDERR, "Could not obtain the .cod package (private constancias need --cod).\n"); exit(2); }
$files = constanciaReadCod($cod);
$didJson = hcodGet("$base/.well-known/did.json");
$did = is_string($didJson) ? json_decode($didJson, true) : null;
if ($files === null || !is_array($did)) { fwrite(STDERR, "Invalid package or unreachable DID document.\n"); exit(2); }
$assetHash = isset($opts['asset']) && is_readable($opts['asset']) ? hash_file('sha512', $opts['asset']) : null;

$r = constanciaVerifyPackage($files, $did, $opts['ca'] ?? constanciaCaFile(), $assetHash);
echo "hcod verify $number  ($base)\n";
foreach ($r['checks'] as $c) echo ($c['ok'] ? ' ✓ ' : ' ✗ ') . $c['label'] . "\n     " . $c['detail'] . "\n";
echo $r['ok'] ? "\nRESULT: all checks passed\n" : "\nRESULT: verification FAILED\n";
exit($r['ok'] ? 0 : 1);
