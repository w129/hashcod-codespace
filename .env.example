SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxx
SUPABASE_SECRET_KEY=sb_secret_xxxxx
SUPABASE_STORAGE_BUCKET=l8-storage

# Token GitHub (Settings → Developer settings → Fine-grained or classic PAT)
# En Render: Environment → GITHUB_TOKEN. Sin token funciona en público con límite bajo.
GITHUB_TOKEN=ghp_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Claude Code (ventana externa /claude) — OAuth preferido (claude setup-token)
# Alternativa: ANTHROPIC_API_KEY desde console.anthropic.com
CLAUDE_CODE_OAUTH_TOKEN=
ANTHROPIC_API_KEY=

# Opcional: tras crear tablas con supabase/schema.sql en el SQL Editor,
# la plataforma también espeja repos/archivos en Postgres (además de Storage).
