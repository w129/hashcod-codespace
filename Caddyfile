{
	admin off
	auto_https off
	servers {
		timeouts {
			read_body 30s
			read_header 10s
			write 120s
			idle 60s
		}
	}
}

# Render termina TLS en el edge y llega HTTP a $PORT.
# Sin "http://:" Caddy trata el número como hostname y sirve HTTPS →
# "Client sent an HTTP request to an HTTPS server."
http://:{$PORT:8000} {
	# SEO público: servir robots y sitemap directamente desde Caddy.
	# Esto evita que Googlebot atraviese el bootstrap de seguridad/Turnstile y
	# garantiza respuestas 200 simples con el MIME correcto para Search Console.
	handle /robots.txt {
		root * /var/www/html
		header Content-Type "text/plain; charset=utf-8"
		header Cache-Control "no-store, max-age=0, must-revalidate"
		header -ETag
		header -Last-Modified
		file_server
	}
	handle /sitemap.xml {
		root * /var/www/html
		header Content-Type "application/xml; charset=utf-8"
		header Cache-Control "no-store, max-age=0, must-revalidate"
		header -ETag
		header -Last-Modified
		file_server
	}

	# Streamlit slots (websockets vía reverse_proxy).
	# Si el proceso no está arrancado → connection refused (normal en idle / post-redeploy).
	@st1 path /st/1 /st/1/*
	handle @st1 {
		reverse_proxy 127.0.0.1:8501 {
			transport http {
				dial_timeout 800ms
				response_header_timeout 120s
			}
		}
	}
	@st2 path /st/2 /st/2/*
	handle @st2 {
		reverse_proxy 127.0.0.1:8502 {
			transport http {
				dial_timeout 800ms
				response_header_timeout 120s
			}
		}
	}
	@st3 path /st/3 /st/3/*
	handle @st3 {
		reverse_proxy 127.0.0.1:8503 {
			transport http {
				dial_timeout 800ms
				response_header_timeout 120s
			}
		}
	}
	@st4 path /st/4 /st/4/*
	handle @st4 {
		reverse_proxy 127.0.0.1:8504 {
			transport http {
				dial_timeout 800ms
				response_header_timeout 120s
			}
		}
	}
	@st5 path /st/5 /st/5/*
	handle @st5 {
		reverse_proxy 127.0.0.1:8505 {
			transport http {
				dial_timeout 800ms
				response_header_timeout 120s
			}
		}
	}
	@st6 path /st/6 /st/6/*
	handle @st6 {
		reverse_proxy 127.0.0.1:8506 {
			transport http {
				dial_timeout 800ms
				response_header_timeout 120s
			}
		}
	}
	@st7 path /st/7 /st/7/*
	handle @st7 {
		reverse_proxy 127.0.0.1:8507 {
			transport http {
				dial_timeout 800ms
				response_header_timeout 120s
			}
		}
	}
	@st8 path /st/8 /st/8/*
	handle @st8 {
		reverse_proxy 127.0.0.1:8508 {
			transport http {
				dial_timeout 800ms
				response_header_timeout 120s
			}
		}
	}

	# Static assets direct edge offloading & compression
	@static {
		path *.css *.js *.mjs *.svg *.png *.jpg *.jpeg *.gif *.webp *.ico *.woff *.woff2 *.wasm *.ttf *.map *.webmanifest
		not path /data_storage/*
		not path /uploads/*
		not path /.git/*
	}
	handle @static {
		root * /var/www/html
		encode zstd gzip

		@versioned {
			query v=* ver=* hash=* t=* id=*
			path_regexp hashed -[a-zA-Z0-9_-]{6,}\.(js|css|wasm|svg|png|woff2?)$
		}
		header @versioned Cache-Control "public, max-age=31536000, immutable"
		header not @versioned Cache-Control "public, max-age=86400, stale-while-revalidate=604800"

		file_server {
			hide .git data_storage uploads
		}
	}

	# Plataforma PHP dinámica (compresión zstd + gzip)
	handle {
		encode zstd gzip
		# Trust only Render's private ingress or Cloudflare's published edge ranges.
		# Strip the visitor header on any direct connection from another network.
		@untrustedAdminIngress {
			not remote_ip private_ranges 173.245.48.0/20 103.21.244.0/22 103.22.200.0/22 103.31.4.0/22 141.101.64.0/18 108.162.192.0/18 190.93.240.0/20 188.114.96.0/20 197.234.240.0/22 198.41.128.0/17 162.158.0.0/15 104.16.0.0/13 104.24.0.0/14 172.64.0.0/13 131.0.72.0/22 2400:cb00::/32 2606:4700::/32 2803:f800::/32 2405:b500::/32 2405:8100::/32 2a06:98c0::/29 2c0f:f248::/32
		}
		request_header @untrustedAdminIngress -CF-Connecting-IP
		reverse_proxy 127.0.0.1:8001 {
			header_up X-L8-Render-Cf-Ip {http.request.header.CF-Connecting-IP}
			header_up -X-L8-Render-Xff
			transport http {
				dial_timeout 3s
				response_header_timeout 60s
				read_buffer 4096
				write_buffer 4096
			}
		}
	}

	# 502 de Streamlit idle → página clara (CEL sin librería strings: Caddy de Render no la trae)
	handle_errors {
		@st_offline {
			expression `{err.status_code} == 502`
			path_regexp st ^/st/
		}
		handle @st_offline {
			root * /var/www/html
			rewrite * /public-st-offline.html
			file_server
			header Content-Type "text/html; charset=utf-8"
			header Cache-Control "no-store"
		}
	}
}
