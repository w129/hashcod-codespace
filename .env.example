# l8 codespace — variables de entorno (Render / local)
# Copia a .env en local. NUNCA subas .env con secretos reales.
# En Render también puedes usar Secret Files en /etc/secrets/<KEY>.

# ===== Supabase (solo backend; nunca en el frontend) =====
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
SUPABASE_STORAGE_BUCKET=l8-storage

# ===== Cloudflare Turnstile =====
# Site key pública + secret key privada del widget configurado para el dominio.
CF_TURNSTILE_SITE_KEY=
CF_TURNSTILE_SECRET_KEY=

# ===== Auth =====
# Módulo ML-DSA-87 (Dilithium-5 categoría 5, NIST FIPS 204).
# Ya no es un requisito para entrar a Hashcod Codespace.
# La clave pública puede sobreescribir config/mldsa87-access-public.b64.
# La clave privada NUNCA debe configurarse en Railway ni subirse al repositorio.
L8_ACCESS_MLDSA87_PUBLIC_KEY_B64=
L8_ACCESS_MLDSA87_REQUIRED=0
L8_ACCESS_MLDSA87_TTL=1800
L8_ACCESS_MLDSA87_PHASE1_TTL=90
L8_ACCESS_MLDSA87_PHASE2_TTL=60
# Secreto >=32 caracteres para firmar cookies de reto/acceso. Si queda vacío,
# Hashcod deriva/persiste uno desde la bóveda del servidor.
L8_ACCESS_GATE_COOKIE_SECRET=

# Gate de registro mensual Dilithium-5 (solo env / secret file).
L8_DILITHIUM5_REGISTER_KEY=
L8_DILITHIUM5_REGISTER_PERIOD=2026-08

# Pepper HMAC para hashes de claves de usuario.
# RECOMENDADO fijarlo en Render para que login/recuperación sobrevivan redeploys.
L8_AUTH_PEPPER=

# ===== Seguridad / bóveda =====
# Clave maestra de la bóveda cifrada local (data_storage/security/vault.enc).
# Hex 64 chars o cualquier string (se deriva a SHA-256).
L8_VAULT_MASTER_KEY=

# Semilla opcional para el cifrado de registros. Hashcod persiste la clave
# canónica de registros dentro del bucket privado de Supabase para sobrevivir
# redeploys; si esta variable existe durante el primer bootstrap, la deriva.
L8_DATA_ENCRYPTION_KEY=

# Semilla Dilithium unlock de tokens (x1, x2, …). Si falta, se usa legacy + bóveda.
L8_TOKENS_UNLOCK_SEED=

# CORS allowlist exacta, coma-separada. Vacío = solo same-origin.
# Ejemplo: https://hashcodcodespace.dev
L8_CORS_ORIGINS=

# Instancia DeskcommCRM opcional que se abre desde el botón CRM de la topbar.
# Debe ser una URL http/https completa. Vacío = solo CRM interno de plataformas.
# Ejemplo: https://crm.hashcodcodespace.dev
DESKCOMM_CRM_URL=

# Confiar en el proxy validado del proveedor (1 en Railway/hosting, 0 en local directo).
L8_TRUST_PROXY=1

# Exigir sesión de cuenta en mutaciones sensibles (upload, clone, command, streamlit, …).
L8_REQUIRE_AUTH_MUTATIONS=1

# Secreto opcional para /api/env/status y regenerar SSH (header X-L8-Admin).
L8_ADMIN_DIAG_SECRET=

# ===== WebSocket opcional =====
# El servidor ws-server.js falla cerrado si no existe un secreto >= 32 caracteres.
# No reutilices contraseñas, API keys ni secretos de Supabase.
WS_SECRET=
# Orígenes web autorizados, separados por coma. Vacío = ningún navegador externo.
# Ejemplo: https://hashcodcodespace.dev
WS_ALLOWED_ORIGINS=

# ===== OpenClaw webhook opcional =====
# Secreto independiente de >=32 caracteres para X-OpenClaw-Secret.
OPENCLAW_WEBHOOK_SECRET=

# Tras el primer deploy auth: ejecuta supabase/schema.sql en el SQL Editor
# (tablas + RLS deny-all para anon/authenticated).

# ===== Chat IA del bloc de notas (OAuth por modelo) =====
# Redirect URI a registrar en cada proveedor:
#   https://<tu-dominio>/api/ai/oauth/callback
# AI_CHAT_OAUTH_REDIRECT_URI=https://<tu-dominio>/api/ai/oauth/callback

# GPT 5.6 (OpenAI)
OPENAI_CLIENT_ID=
OPENAI_CLIENT_SECRET=
OPENAI_API_KEY=
OPENAI_CHAT_MODEL=gpt-4o

# Gemini 3.6 (Google)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GEMINI_API_KEY=
GEMINI_CHAT_MODEL=gemini-2.0-flash

# Claude Fable 5 (Anthropic)
ANTHROPIC_CLIENT_ID=
ANTHROPIC_CLIENT_SECRET=
ANTHROPIC_API_KEY=
CLAUDE_CODE_OAUTH_TOKEN=
ANTHROPIC_CHAT_MODEL=claude-sonnet-4-20250514

# Manus
MANUS_CLIENT_ID=
MANUS_CLIENT_SECRET=
MANUS_API_KEY=
MANUS_AGENT_PROFILE=manus-1.6

# ===== Hashcod AI en la pantalla de acceso (OpenRouter) =====
# La API key debe configurarse SOLO en Render/env o como Secret File.
# Nunca la pongas en HTML, JS ni en este archivo si va a GitHub.
OPENROUTER_API_KEY=
OPENROUTER_CHAT_MODEL=openai/gpt-oss-120b


# Código opcional de 6 dígitos para reemplazar el código interno del editor del ProductCard.
# Configúralo únicamente como secreto del deployment.
HASHCOD_ENTRY_PRODUCT_EDIT_CODE=


# Optional dedicated HMAC secret for signed per-device usage identifiers.
# If omitted, the platform derives a key from its existing encrypted secret material.
HASHCOD_DEVICE_USAGE_SECRET=


# ===== Post-quantum action bus =====
# When enabled, state-changing requests require a short-lived permit minted from
# an ML-DSA-87-signed action receipt. Roll out after validating all legacy XHR/form paths.
HASHCOD_PQC_ACTION_ENFORCE=0

# Optional HMAC root for session/permit sealing. If empty, Hashcod derives/stores
# one from the encrypted platform vault. Never expose it to frontend code.
HASHCOD_PQC_ACTION_HMAC_SECRET=

# Action-signing ML-DSA-87 keys are auto-generated server-side and stored in the
# encrypted secrets vault by default. Set to 0 only when an external signer/key
# provisioning process supplies HASHCOD_ACTION_MLDSA87_* secrets securely.
HASHCOD_ACTION_MLDSA87_AUTO_GENERATE=1

# ===== Vision tool (camera + Detectron2 object detection) =====
# Base URL and shared bearer of the Detectron2 service (services/detectron2-vision).
# Leave empty to keep the camera/recording working with detection disabled.
DETECTRON2_URL=
DETECTRON2_TOKEN=
